{
	"name": "DF_Logistics_Silver_to_Gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "silvertogold"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          ORDER_ID as string,",
				"          CUSTOMER_ID as string,",
				"          PRODUCT_ID as string,",
				"          TOTAL_AMOUNT as decimal(18,2),",
				"          PAYMENT_METHOD as string,",
				"          ORDER_DATE as timestamp,",
				"          ORDER_STATUS as string,",
				"          LAST_UPDATED as timestamp,",
				"          LAST_UPDATED_AT as timestamp",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/orders_valid',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> silvertogold"
			]
		}
	}
}