{
	"name": "DF_Logistics_Silver_to_Gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "OrdersSource"
				},
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "CustomersSource"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          email as string,",
				"          phone_number as string,",
				"          gender as string,",
				"          customer_segment as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          pincode as string,",
				"          registered_at as string,",
				"          last_updated_at as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/orders_valid',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> OrdersSource",
				"source(useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/customers',",
				"     fileName: 'customers_silver.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> CustomersSource"
			]
		}
	}
}