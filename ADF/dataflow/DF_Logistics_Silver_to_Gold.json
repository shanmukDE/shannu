{
	"name": "DF_Logistics_Silver_to_Gold",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "OrdersSource"
				},
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "CustomersSource"
				},
				{
					"linkedService": {
						"referenceName": "LS_sbboardingdev673",
						"type": "LinkedServiceReference"
					},
					"name": "ProductsSource"
				},
				{
					"name": "SellersSource"
				},
				{
					"name": "ShipmentsSource"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          ORDER_ID as string,",
				"          CUSTOMER_ID as string,",
				"          PRODUCT_ID as string,",
				"          TOTAL_AMOUNT as decimal(18,2),",
				"          PAYMENT_METHOD as string,",
				"          ORDER_DATE as timestamp,",
				"          ORDER_STATUS as string,",
				"          LAST_UPDATED as timestamp,",
				"          LAST_UPDATED_AT as timestamp",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/orders_valid',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> OrdersSource",
				"source(output(",
				"          customer_id as string,",
				"          name as string,",
				"          email as string,",
				"          phone_number as string,",
				"          gender as string,",
				"          customer_segment as string,",
				"          address as string,",
				"          city as string,",
				"          state as string,",
				"          pincode as string,",
				"          registered_at as string,",
				"          last_updated_at as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/customers',",
				"     fileName: 'customers_silver.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> CustomersSource",
				"source(output(",
				"          product_id as string,",
				"          product_name as string,",
				"          category as string,",
				"          last_updated_at as string,",
				"          price as decimal(18,2)",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'output',",
				"     folderPath: 'SILVER/Logistics/products',",
				"     fileName: 'products_silver.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> ProductsSource",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> ",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> "
			]
		}
	}
}