		{
			"name": "[concat(parameters('factoryName'), '/DF_Orders_Bronze_to_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Orders",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Orders_Silver_CSV",
								"type": "DatasetReference"
							},
							"name": "SinkValidOrders"
						},
						{
							"dataset": {
								"referenceName": "DS_Orders_Rejected_CSV",
								"type": "DatasetReference"
							},
							"name": "SinkInvalidOrders"
						}
					],
					"transformations": [
						{
							"name": "DerivedOrderColumns"
						},
						{
							"name": "SplitOrdersQuality"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ORDER_ID as string,",
						"          CUSTOMER_ID as string,",
						"          PRODUCT_ID as string,",
						"          TOTAL_AMOUNT as string,",
						"          PAYMENT_METHOD as string,",
						"          ORDER_DATE as string,",
						"          ORDER_STATUS as string,",
						"          LAST_UPDATED as string,",
						"          LAST_UPDATED_AT as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 derive(TOTAL_AMOUNT = toDecimal(TOTAL_AMOUNT, 18, 2),",
						"          ORDER_DATE = toTimestamp(ORDER_DATE, 'yyyy-MM-dd HH:mm:ss'),",
						"          LAST_UPDATED = toTimestamp(LAST_UPDATED, 'yyyy-MM-dd HH:mm:ss'),",
						"          LAST_UPDATED_AT = toTimestamp(LAST_UPDATED_AT, 'yyyy-MM-dd HH:mm:ss')) ~> DerivedOrderColumns",
						"DerivedOrderColumns split(!isNull(ORDER_ID) && !isNull(TOTAL_AMOUNT) && !isNull(ORDER_DATE) && length(trim(ORDER_ID)) > 0 && TOTAL_AMOUNT >= 0,",
						"     disjoint: false) ~> SplitOrdersQuality@(ValidOrders, InvalidOrders)",
						"SplitOrdersQuality@ValidOrders sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SinkValidOrders",
						"SplitOrdersQuality@InvalidOrders sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SinkInvalidOrders"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Shipments_Bronze_to_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Shipments_Bronze_JSON",
								"type": "DatasetReference"
							},
							"name": "SourceSHipmentBronze"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Shipments_Silver_CSV",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          carrier as (carrier_id as string, carrier_name as string),",
						"          charges as (cod_fee as double, fuel_surcharge as double, insurance as double, shipping_cost as double),",
						"          metadata as (api_version as string, created_ts as string, source as string),",
						"          order_reference as (channel as string, order_id as string, seller_id as string),",
						"          route as (destination as (city as string, customer_address_type as string, pincode as string), origin as (city as string, pincode as string, warehouse_id as string)),",
						"          shipment_details as (created_at as string, delay_flag as boolean, delivered_at as string, delivery_tat_days as integer, rto_flag as boolean, status as string, status_tracking as (location as string, status as string, timestamp as string)[]),",
						"          shipment_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> SourceSHipmentBronze",
						"SourceSHipmentBronze derive(order_id = order_reference.order_id,",
						"          carrier_name = carrier.carrier_name,",
						"          shipping_cost = charges.shipping_cost,",
						"          shipment_status = shipment_details.status,",
						"          seller_id = order_reference.seller_id) ~> derivedColumn1",
						"derivedColumn1 select(mapColumn(",
						"          shipment_id,",
						"          order_id,",
						"          carrier_name,",
						"          shipping_cost,",
						"          shipment_status,",
						"          seller_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['shipments_silver.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
